{
  "compilerOptions": {
    "composite": true,              // <- necesario si usás "references" en el tsconfig raíz
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],              // <- tipado de Node para vite.config.ts
    "skipLibCheck": true,
    "noEmit": true,

    // Lint "light": no hace falta ser estricto acá
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["vite.config.ts"]
}
